{
	"compilerOptions": {
		"target": "es2015",
		"module": "commonjs",
		"declaration": true,
		"outDir": "./lib",
		"strict": true,
		"jsx": "react",
		"skipLibCheck": true,
		"strictNullChecks": true,
		"lib": [ "dom", "es5", "scripthost", "es2019", "es6", "es2020" ],
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		"**/__tests__/*"
	]
}